# ---- Core ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# WEB_ORIGIN (used to build email links) and CORS_ORIGINS are OPTIONAL:
# when unset, the server auto-detects the current LAN IP each startup, and dev
# CORS allows any localhost/private-LAN origin — so phone testing works with no
# config on any network. Set them only to pin a specific origin (e.g. a deploy).
# WEB_ORIGIN=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.50:5173

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Cloudinary (uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ---- Paystack (test mode) ----
# Get free test keys at https://dashboard.paystack.com/#/settings/developers
# Leave PAYSTACK_SECRET_KEY blank to fall back to the instant simulated deposit
# (POST /api/wallet/deposit). With a key set, use POST /api/wallet/deposit/init.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Where Paystack returns the buyer after paying (a frontend route).
PAYSTACK_CALLBACK_URL=http://localhost:5173/wallet/deposit/callback
# Webhook URL to register in the Paystack dashboard (use an ngrok/tunnel URL in
# dev since Paystack can't reach localhost): <public-url>/api/wallet/webhook/paystack
# On localhost without a tunnel, poll GET /api/wallet/deposit/verify/:reference instead.

# ---- NOWPayments (sandbox) — the crypto rail ----
# Sandbox account + API key: https://account-sandbox.nowpayments.io
# Leave NOWPAYMENTS_API_KEY blank and crypto funding answers 501 (the fiat rail
# is unaffected).
NOWPAYMENTS_API_KEY=
# From the sandbox dashboard's IPN settings — without it every IPN is rejected,
# leaving POST /api/escrows/:id/crypto/check as the only way a deposit settles.
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api-sandbox.nowpayments.io/v1
# Priced in the coin it is paid in, so the amount owed can't drift while the
# buyer is paying. Repoint both if the sandbox doesn't carry TRX.
NOWPAYMENTS_PRICE_CURRENCY=trx
NOWPAYMENTS_PAY_CURRENCY=trx
# Public origin of THIS API — the IPN is sent to <SERVER_ORIGIN>/api/escrows/webhook/nowpayments.
# Defaults to http://localhost:$PORT, which the provider cannot reach; that is
# what the /crypto/check poll covers. Point it at an ngrok/cloudflared tunnel to
# exercise the webhook path for real.
# SERVER_ORIGIN=https://your-tunnel.ngrok-free.app

# ---- Mail ----
# simulated | smtp | resend | brevo   ("simulated" just logs the subject; default)
#
#   smtp    works locally. It does NOT work on Render, which blocks outbound
#           SMTP: the connection times out, and because nothing ever reaches a
#           mail server, nothing bounces — the mail silently disappears.
#   brevo   posts to Brevo's HTTPS API on :443, which no host blocks. Use this
#           on Render. Needs BREVO_API_KEY below.
#   resend  posts to Resend's HTTPS API on :443. Use either API driver on Render.
MAIL_DRIVER=simulated

# Must be an address the provider has authorised, or mail is rejected or
# silently rewritten. For Brevo, use a sender address already verified in its
# dashboard. The display-name form `VeriTrust <sender@example.com>` is supported.
MAIL_FROM=VeriTrust <no-reply@veritrust.app>

# --- MAIL_DRIVER=smtp ---
# Gmail needs a 16-character App Password (2FA on the account), not the account
# password. Port 587 = STARTTLS, 465 = implicit TLS; the code picks TLS mode
# from the port, so the two must agree.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- MAIL_DRIVER=resend ---
# https://resend.com/api-keys (free tier: 3,000/month). Send-only scope is
# enough.
RESEND_API_KEY=

# --- MAIL_DRIVER=brevo ---
# https://app.brevo.com/settings/keys/api — use an API key with transactional
# email permission. Set this only in the deployment environment, never commit it.
BREVO_API_KEY=

# ---- Database keep-alive ----
# Neon scales the compute to zero after a few minutes with no queries (five, on
# the plans where it isn't configurable). Waking it costs seconds and drops
# every pooled connection, so the first requests after a quiet spell are slow —
# that is what an occasional 30-second page load actually is.
#
# One trivial query on this interval keeps it awake. Four minutes leaves a
# margin under the threshold. Set to 0 against a database that doesn't suspend.
DB_KEEPALIVE_MS=240000

# ---- Crypto sandbox settlement ----
# NOWPayments' SANDBOX marks a payment `finished` while still reporting
# `actually_paid: 0`, so the underpayment guard in crypto.service correctly
# refuses to fund and the deal sits at `partially_paid` forever — which makes
# the TRX rail impossible to demonstrate end to end.
#
# Setting this true lets the provider's status alone settle a deposit. It is
# gated twice: this flag AND a sandbox base URL, so copying a production .env
# that still carries it cannot switch it on. Every settlement it affects logs a
# warning, and the server says so at boot.
#
# NEVER set this with live keys — it bypasses the check that stops a seller
# being handed an escrow the buyer never paid for.
# NOWPAYMENTS_TRUST_STATUS=true
