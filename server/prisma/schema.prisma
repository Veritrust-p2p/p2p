// P2P Marketplace Escrow — simplified from the TaaS schema to the proposal scope:
// 6-state escrow, simulated GHS wallet, real TRX (Shasta testnet), usernames,
// share-code/QR join, disputes settled by a final admin ruling.
// Enum values are lowercase to match the web client's vocabulary exactly.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // connection URLs live in prisma.config.ts (Prisma 7)
}

// ---------- Enums ----------

enum UserRole {
  user
  admin
}

enum AccountStatus {
  active
  suspended
}

enum KycStatus {
  pending
  verified
  rejected
}

enum Currency {
  GHS
  TRX
}

enum EscrowRail {
  fiat
  crypto
}

enum EscrowRole {
  buyer
  seller
}

enum EscrowStatus {
  created
  funded
  delivered
  disbursed
  disputed
  cancelled
}

enum MilestoneStatus {
  pending
  delivered
  disbursed
}

enum PaymentStatus {
  pending
  success
  failed
}

/// `pending` — money already debited, waiting on an admin.
/// `completed` — admin confirmed it was actually sent.
/// `rejected` — admin refused it; the debit is credited back.
enum WithdrawalStatus {
  pending
  completed
  rejected
}

enum TransactionType {
  deposit
  withdrawal
  escrow_fund
  escrow_release
  escrow_refund
  fee
  promotion
}

enum ListingStatus {
  draft
  active
  out_of_stock
  /// Taken down by an admin. Soft state, not a delete — listings referenced by
  /// escrow deals must survive so the deal history stays intact.
  removed
}

enum ListingDisputeStatus {
  open
  approved
  rejected
}

/// Doubles as the buyer-report vocabulary (see ListingReport) — a report is an
/// accusation of exactly the thing a takedown is a finding of, so the reported
/// reason carries straight into the removal with nothing to translate.
enum ListingRemovalReason {
  prohibited_item
  duplicate
  misleading
  spam
  guidelines
  fraud
  other
}

enum ListingReportStatus {
  open
  /// The listing was taken down off the back of it.
  actioned
  /// Reviewed, no violation found.
  dismissed
}

enum PromotionStatus {
  active
  paused
  expired
  cancelled
}

/// Spotlight durations a seller can buy. Mapped so the DB stores the same
/// "7d"/"14d"/"30d" the client speaks — Prisma enum members can't lead with a
/// digit, hence the `d7` names.
enum PromotionPlan {
  d7  @map("7d")
  d14 @map("14d")
  d30 @map("30d")
}

enum DisputeStatus {
  open
  resolved
}

enum DisputeOutcome {
  release
  refund
  split
}

enum DisputeReason {
  not_delivered
  not_as_described
  wrong_item
  service_not_done
  other
}

/// text = a typed chat bubble, file = a Cloudinary attachment card,
/// system = a deal lifecycle notice posted by the escrow/admin services.
enum MessageType {
  text
  file
  system
}

/// Who absorbs the platform fee. Chosen at creation and stored, so the quote a
/// party agreed to is the one settled — see money.ts for the arithmetic.
/// Marketplace checkout is always `split`; standalone deals pick.
enum FeeSplit {
  buyer
  seller
  split
}

/// The *subject area* of a notification, not the individual event — it only
/// drives the icon and accent colour in the panel. Deliberately coarse: a new
/// notifiable action ships by writing a new title/body, with no enum migration.
enum NotificationCategory {
  deal
  listing
  dispute
  kyc
  wallet
  /// Paid listing spotlights. Separate from `listing` so a campaign going live
  /// doesn't wear the same icon as a takedown.
  promotion
  system
}

/// Which set of Paystack keys the platform charges against — see model PaystackMode.
enum PaystackEnvironment {
  test
  live
}

// ---------- Identity ----------

model User {
  id                   String        @id @default(uuid(7))
  username             String        @unique
  email                String        @unique
  passwordHash         String
  fullName             String
  phone                String?
  avatarUrl            String?
  role                 UserRole      @default(user)
  status               AccountStatus @default(active)
  emailVerifiedAt      DateTime?
  phoneVerifiedAt      DateTime?
  // notification preferences (the two checkboxes in Settings)
  emailShipmentUpdates Boolean       @default(true)
  smsReleaseAlerts     Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sessions         Session[]
  kyc              KycProfile?
  kycReviews       KycProfile[]  @relation("KycReviewer")
  wallets          Wallet[]
  paymentIntents   PaymentIntent[]
  withdrawals         Withdrawal[] @relation("WithdrawalUser")
  withdrawalsReviewed Withdrawal[] @relation("WithdrawalReviewer")
  listings         Listing[]
  promotions       Promotion[]
  listingsRemoved  Listing[]        @relation("ListingModerator")
  listingDisputes  ListingDispute[] @relation("ListingDisputeSeller")
  listingDisputesReviewed ListingDispute[] @relation("ListingDisputeReviewer")
  listingReportsMade      ListingReport[]  @relation("ListingReporter")
  listingReportsReviewed  ListingReport[]  @relation("ListingReportReviewer")
  savedListings    SavedListing[]
  blocksMade       VendorBlock[]  @relation("BlocksMade")
  blocksReceived   VendorBlock[]  @relation("BlocksReceived")
  escrowsCreated   Escrow[]       @relation("EscrowCreator")
  escrowsAsBuyer   Escrow[]       @relation("EscrowBuyer")
  escrowsAsSeller  Escrow[]       @relation("EscrowSeller")
  conversationsA   Conversation[] @relation("ConversationUserA")
  conversationsB   Conversation[] @relation("ConversationUserB")
  messagesSent     Message[]
  escrowEvents     EscrowEvent[]
  disputesOpened   Dispute[]     @relation("DisputeOpener")
  disputesResolved Dispute[]     @relation("DisputeResolver")
  reviewsWritten   Review[]      @relation("ReviewAuthor")
  reviewsReceived  Review[]      @relation("ReviewTarget")
  notifications    Notification[]

  @@index([status])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid(7))
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Lightweight KYC — single submission reviewed by an admin (no tiers, no file uploads).
/// Payout destinations are optional (at least one): GHS deals pay momo, TRX deals pay the TRX address.
model KycProfile {
  id              String    @id @default(uuid(7))
  userId          String    @unique
  legalName       String
  storeName       String
  taxId           String?
  country         String
  address         String
  idType          String
  idNumber        String
  momoNumber      String? // fiat payout destination (simulated momo)
  trxAddress      String? // crypto payout destination (TRX address, Shasta)
  status          KycStatus  @default(pending)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("KycReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@map("kyc_profiles")
}

// ---------- Money (one Wallet row per user per currency: GHS and TRX) ----------
// Both rails settle through the same ledger. A TRX deposit confirmed by the
// provider credits the TRX wallet, funding a TRX deal debits it, and releasing
// one credits the seller's. What the provider holds off-platform is the float
// backing those balances. Amounts are Decimal(14,2) for both currencies, so TRX
// is carried to the hundredth of a coin.

model Wallet {
  id        String   @id @default(uuid(7))
  userId    String
  currency  Currency @default(GHS)
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, currency])
  @@map("wallets")
}

model Transaction {
  id        String          @id @default(uuid(7))
  walletId  String
  type      TransactionType
  amount    Decimal         @db.Decimal(14, 2) // positive = credit, negative = debit
  escrowId  String?
  note      String?
  createdAt DateTime        @default(now())

  wallet Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  escrow Escrow? @relation(fields: [escrowId], references: [id])

  @@index([walletId, createdAt])
  @@map("transactions")
}

/// A Paystack (test-mode) deposit attempt. Created `pending` at /deposit/init;
/// flipped to `success` — exactly once — by the signature-verified webhook or
/// the /deposit/verify poll, which is when the wallet is actually credited.
/// `reference` is the Paystack transaction reference and the idempotency key.
model PaymentIntent {
  id        String        @id @default(uuid(7))
  userId    String
  reference String        @unique
  amount    Decimal       @db.Decimal(14, 2)
  currency  Currency      @default(GHS)
  provider  String        @default("paystack")
  status    PaymentStatus @default(pending)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("payment_intents")
}

/// A payout request. The counterpart to PaymentIntent on the way out, and the
/// thing that makes money leaving the platform auditable — previously a payout
/// left only a Transaction row, invisible to admins and impossible to retry or
/// reverse.
///
/// The wallet is debited when the request is created, not when an admin
/// approves it: otherwise the same balance could back several pending requests
/// at once. Rejecting therefore *credits the money back* rather than merely
/// cancelling a plan to send it.
model Withdrawal {
  id        String           @id @default(uuid(7))
  userId    String
  /// Idempotency key, and the payout's public reference. The client mints it
  /// and reuses it on every retry of the same payout; a resubmission is
  /// answered with the original row instead of debiting a second time. Older
  /// clients send none and get a generated one, which is unique but protects
  /// nothing — two taps are then two payouts.
  reference String           @unique
  amount    Decimal          @db.Decimal(14, 2)
  currency  Currency         @default(GHS)
  /// Momo number for GHS, TRON address for TRX — validated per currency.
  destination String
  status    WithdrawalStatus @default(pending)
  /// Why an admin rejected it, shown to the user.
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user       User  @relation("WithdrawalUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("WithdrawalReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("withdrawals")
}

/// A seller's appeal against a listing takedown. Only one may be open per
/// listing; approving it reinstates the listing, rejecting leaves it removed.
model ListingDispute {
  id           String               @id @default(uuid(7))
  listingId    String
  sellerId     String
  status       ListingDisputeStatus @default(open)
  explanation  String // why the seller believes it should be reinstated
  reviewNote   String? // admin's note on the decision
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())

  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller     User    @relation("ListingDisputeSeller", fields: [sellerId], references: [id])
  reviewedBy User?   @relation("ListingDisputeReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([listingId])
  @@map("listing_disputes")
}

/// A buyer flagging a listing. The mirror of ListingDispute: moderation reaching
/// admins from the shopfront side rather than from the seller's.
///
/// Reasons reuse ListingRemovalReason, so a report the admin agrees with becomes
/// the takedown reason unchanged. Resolution isn't a separate decision either —
/// removing the listing marks its open reports `actioned`; `dismissed` is the
/// only ruling that needs its own call.
model ListingReport {
  id           String              @id @default(uuid(7))
  listingId    String
  reporterId   String
  reason       ListingRemovalReason
  note         String? // reporter's own words; required by validation when reason is `other`
  status       ListingReportStatus @default(open)
  reviewNote   String? // admin's note on a dismissal
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())

  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User    @relation("ListingReporter", fields: [reporterId], references: [id])
  reviewedBy User?   @relation("ListingReportReviewer", fields: [reviewedById], references: [id])

  // One report per person per listing — the whole abuse control. A user who
  // reported once has said their piece, whatever the outcome was.
  @@unique([listingId, reporterId])
  @@index([status, createdAt])
  @@index([listingId])
  @@map("listing_reports")
}

// ---------- Marketplace ----------

model Category {
  id        String   @id @default(uuid(7))
  name      String   @unique
  slug      String   @unique
  icon      String? // lucide icon name for the client
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("categories")
}

model Listing {
  id          String        @id @default(uuid(7))
  sellerId    String
  title       String
  description String?
  price       Decimal       @db.Decimal(14, 2)
  currency    Currency      @default(GHS)
  category    String
  condition   String?
  quantity    Int           @default(1)
  views       Int           @default(0)
  images      String[] // URLs (no upload infra at this scope)
  location    String?
  status      ListingStatus @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Admin takedown trail (set together when status becomes `removed`)
  removalReason ListingRemovalReason?
  removalNote   String? // free text, required when the reason is `other`
  removedAt     DateTime?
  removedById   String?
  /// Whether the seller may appeal this removal — the admin decides per takedown.
  /// Severe violations are removed without appeal; correctable ones allow it.
  disputeAllowed Boolean @default(false)

  seller    User             @relation(fields: [sellerId], references: [id])
  removedBy User?            @relation("ListingModerator", fields: [removedById], references: [id])
  promotions Promotion[]
  disputes  ListingDispute[]
  reports   ListingReport[]
  savedBy   SavedListing[]
  escrows   Escrow[]
  reviews   Review[]

  @@index([status, category])
  @@index([sellerId])
  @@map("listings")
}

model Promotion {
  id         String          @id @default(uuid(7))
  listingId  String
  sellerId   String
  status     PromotionStatus @default(active)
  plan       PromotionPlan
  priority   Int             @default(0)
  /// What the seller was actually charged for this run, in GHS. Recorded so the
  /// spend history survives a later change to the price list.
  amount     Decimal         @db.Decimal(14, 2)
  startsAt   DateTime        @default(now())
  endsAt     DateTime?
  /// Seconds left on the clock when the seller paused. Resuming sets
  /// `endsAt = now + this` so a pause banks the remaining time instead of
  remainingSeconds Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller  User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([sellerId, status])
  @@index([status, endsAt])
  @@map("promotions")
}

/// A user blocking a vendor (with a stated reason) — hides the vendor's
/// listings from them and disables contact.
model VendorBlock {
  id        String   @id @default(uuid(7))
  userId    String // who blocked
  vendorId  String // who is blocked
  reason    String
  createdAt DateTime @default(now())

  user   User @relation("BlocksMade", fields: [userId], references: [id], onDelete: Cascade)
  vendor User @relation("BlocksReceived", fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
  @@map("vendor_blocks")
}

model SavedListing {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("saved_listings")
}

// ---------- Escrow (the core — 5 states) ----------

model Escrow {
  id              String       @id @default(uuid(7))
  code            String       @unique // share code, e.g. ESC-8F3K2M
  title           String
  description     String?
  listingId       String? // set when created from a marketplace listing
  quantity        Int?
  creatorId       String
  creatorRole     EscrowRole
  buyerId         String?
  sellerId        String?
  invitedUsername String? // unresolved counterparty invite; joinable by code
  amount          Decimal      @db.Decimal(14, 2)
  feeAmount       Decimal      @default(0) @db.Decimal(14, 2) // fiat 1.5% / crypto 1.0%
  feeSplit        FeeSplit     @default(split) // who absorbs feeAmount
  currency        Currency
  rail            EscrowRail
  status          EscrowStatus @default(created)
  // seller dispatch info (deliver transition)
  carrier         String?
  trackingNumber  String?
  deliveryNote    String?
  cancelReason    String? // why the seller pulled out (optional, shown to the buyer)
  // time-locked auto-release (set on deliver; frozen by dispute)
  autoReleaseAt   DateTime?
  fundedAt        DateTime?
  deliveredAt     DateTime?
  disbursedAt     DateTime?
  disputedAt      DateTime?
  cancelledAt     DateTime? // seller pulled out of a funded order; buyer refunded in full
  /// The share QR, rendered once on first view and kept — it never changes for
  /// a given code, and re-encoding the PNG on every open of the deal page was
  /// pure CPU waste.
  shareQrDataUrl  String?
  /// The WEB_ORIGIN the stored QR encodes. A deployment onto a new domain makes
  /// the old image point at the old host, so the two are compared on read and a
  /// mismatch re-renders rather than serving a dead link.
  shareQrOrigin   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  listing      Listing?      @relation(fields: [listingId], references: [id])
  creator      User          @relation("EscrowCreator", fields: [creatorId], references: [id])
  buyer        User?         @relation("EscrowBuyer", fields: [buyerId], references: [id])
  seller       User?         @relation("EscrowSeller", fields: [sellerId], references: [id])
  milestones   Milestone[]
  messages     Message[] // deal-linked messages in the parties' conversation
  events       EscrowEvent[]
  dispute      Dispute?
  crypto       CryptoEscrow?
  transactions Transaction[]
  reviews      Review[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, autoReleaseAt])
  @@map("escrows")
}

/// Milestone markers for digital-goods/service deals (pending → delivered → disbursed).
model Milestone {
  id          String          @id @default(uuid(7))
  escrowId    String
  position    Int
  title       String
  amount      Decimal         @db.Decimal(14, 2)
  status      MilestoneStatus @default(pending)
  deliveredAt DateTime?
  disbursedAt DateTime?

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@unique([escrowId, position])
  @@map("milestones")
}

/// One conversation per user pair (Binance-style) — all deals between two users
/// happen alongside this single thread. userAId < userBId (normalized in service).
model Conversation {
  id        String   @id @default(uuid(7))
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@map("conversations")
}

/// Immutable messages — auto-attached as evidence when a dispute opens.
/// escrowId links deal-related/system messages to the deal they reference.
/// type drives the client renderer: a chat bubble, a file card, or a centered
/// system chip — no sniffing URLs out of the body.
model Message {
  id             String      @id @default(uuid(7))
  conversationId String
  senderId       String
  type           MessageType @default(text)
  body           String
  // Set when type = file. Bytes live in Cloudinary (POST /api/upload/single);
  // only the resulting URL + metadata travel over the socket.
  attachmentUrl  String?
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?
  escrowId       String?
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  escrow       Escrow?      @relation(fields: [escrowId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// A one-way in-app notice. Unlike a Message it has no thread, no sender and no
/// reply path — when a user genuinely needs to answer something (a takedown),
/// the structured route is the one to take: ListingDispute, not a chat bubble.
///
/// `link` is a client route the row opens (e.g. /deals/<id>). Nullable because
/// some notices are purely informational.
model Notification {
  id        String               @id @default(uuid(7))
  userId    String
  category  NotificationCategory
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The panel reads newest-first; the badge counts where readAt IS NULL.
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Append-only timeline of every state transition (detail-page stepper + admin oversight).
model EscrowEvent {
  id        String   @id @default(uuid(7))
  escrowId  String
  actorId   String?
  actorRole String // buyer | seller | system | admin
  event     String // e.g. created, joined, funded, delivered, released, disputed, ruled
  detail    Json?
  createdAt DateTime @default(now())

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([escrowId, createdAt])
  @@map("escrow_events")
}

// ---------- Disputes ----------

model Dispute {
  id                String          @id @default(uuid(7))
  escrowId          String          @unique
  openedById        String
  reason            DisputeReason
  description       String
  status            DisputeStatus   @default(open)
  outcome           DisputeOutcome?
  ruledAmountBuyer  Decimal?        @db.Decimal(14, 2) // for split rulings
  ruledAmountSeller Decimal?        @db.Decimal(14, 2)
  rulingNote        String?
  resolvedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  escrow     Escrow @relation(fields: [escrowId], references: [id])
  openedBy   User   @relation("DisputeOpener", fields: [openedById], references: [id])
  resolvedBy User?  @relation("DisputeResolver", fields: [resolvedById], references: [id])

  // The queue filters on status alone — every ruling is manual, so there is no
  // deadline column to scan alongside it.
  @@index([status])
  @@map("disputes")
}

// ---------- Crypto rail (TRON Shasta testnet — the only real money) ----------

/// The TRX deposit behind a crypto-rail escrow, settled through NOWPayments'
/// hosted invoice. The provider holds the coins and owns the address, so there
/// is no key material here — the platform never takes custody of a private key.
///
/// `orderRef` is our own reference, sent as NOWPayments' `order_id` and echoed
/// back on the IPN. It is the idempotency key for the whole deposit: the FUND
/// transition it triggers is claimed by escrow status, so a webhook and a poll
/// racing each other still fund exactly once.
model CryptoEscrow {
  id                  String    @id @default(uuid(7))
  escrowId            String    @unique
  provider            String    @default("nowpayments")
  orderRef            String    @unique
  invoiceId           String?
  invoiceUrl          String?
  /// Where this invoice sends the buyer back to, as it was resolved when the
  /// invoice was created. Stored so a live invoice can be recognised as stale
  /// when the destination changes — a web invoice reused by the phone would
  /// otherwise redirect into the web app, and an invoice created under an old
  /// WEB_ORIGIN keeps sending people to that host forever.
  returnUrl           String?
  /// Only known once the buyer actually picks a coin on the hosted page — it
  /// arrives on the IPN, or as `NP_id` on the success redirect.
  paymentId           String?
  /// Raw provider status: waiting | confirming | confirmed | sending |
  /// partially_paid | finished | failed | expired | refunded.
  payStatus           String    @default("waiting")
  payCurrency         String    @default("trx")
  depositAddress      String?
  sellerPayoutAddress String?
  buyerRefundAddress  String?
  expectedTrx         Decimal   @db.Decimal(18, 6)
  receivedTrx         Decimal   @default(0) @db.Decimal(18, 6)
  depositTxid         String?
  releaseTxid         String?
  refundTxid          String?
  /// When the deposit was accepted and the escrow moved to `funded`.
  settledAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  escrow Escrow @relation(fields: [escrowId], references: [id])

  @@map("crypto_escrows")
}

// ---------- Reviews ----------

model Review {
  id         String   @id @default(uuid(7))
  escrowId   String
  listingId  String? // shown on the product page when the deal came from a listing
  reviewerId String
  revieweeId String
  rating     Int      @db.SmallInt // 1–5
  comment    String?
  createdAt  DateTime @default(now())

  escrow   Escrow   @relation(fields: [escrowId], references: [id])
  listing  Listing? @relation(fields: [listingId], references: [id])
  reviewer User     @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  reviewee User     @relation("ReviewTarget", fields: [revieweeId], references: [id])

  @@unique([escrowId, reviewerId])
  @@index([revieweeId])
  @@index([listingId])
  @@map("reviews")
}

/// The live/test switch for Paystack, held in the database so it can be flipped
/// at runtime instead of by editing `.env` and restarting the API.
///
/// Exactly one row, pinned to id "singleton" and held there by a CHECK
/// constraint — a second row would make "the current mode" ambiguous.
model PaystackMode {
  id String @id @default("singleton")

  /// `test` selects the sk_test_ secret, `live` the sk_live_ one. Defaulting to
  /// `test` is deliberate: a fresh database, a new environment, or a read that
  /// fails must all mean test mode. Nothing should ever fall back into charging
  /// real cards.
  mode PaystackEnvironment @default(test)

  updatedAt DateTime @updatedAt

  @@map("paystack_mode")
}
